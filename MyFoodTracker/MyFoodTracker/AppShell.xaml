<?xml version="1.0" encoding="UTF-8" ?>
<Shell x:Class="MyFoodTracker.AppShell"
       xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:local="clr-namespace:MyFoodTracker"
       FlyoutBehavior="Disabled">
    <TabBar>
        <ShellContent Title="Foods" ContentTemplate="{DataTemplate local:MainPage}" />
        <ShellContent Title="Hardware" ContentTemplate="{DataTemplate local:HardwarePage}" />
        <ShellContent Title="Settings" ContentTemplate="{DataTemplate local:SettingsPage}" />
    </TabBar>
</Shell>