<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MyFoodTracker.MainPage"
             Title="Foods">
    <Grid RowDefinitions="Auto, *">
        <Grid Padding="10" RowDefinitions="Auto, Auto">
            <SearchBar x:Name="SearchBar" Placeholder="Search name, category or tag" TextChanged="OnSearchTextChanged"/>
            <Button Grid.Row="1" Text="Add New" Clicked="OnAddClicked" Margin="0,8,0,0"/>
        </Grid>
        <RefreshView Grid.Row="1" Refreshing="OnRefresh">
            <CollectionView x:Name="FoodList" SelectionMode="Single" SelectionChanged="OnSelectionChanged">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="12" ColumnDefinitions="*, Auto">
                            <VerticalStackLayout>
                                <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="16"/>
                                <Label Text="{Binding Category}" FontSize="12" TextColor="Gray"/>
                                <Label Text="{Binding CaloriesLabel}" FontSize="12"/>
                            </VerticalStackLayout>
                            <Label Grid.Column="1" Text="Detail" TextColor="Blue" VerticalOptions="Center"/>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>