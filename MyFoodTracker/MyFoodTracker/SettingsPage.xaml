<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MyFoodTracker.SettingsPage"
             Title="Settings">
    <VerticalStackLayout Padding="20" Spacing="15">
        <Label Text="Theme" FontAttributes="Bold"/>
        <Picker x:Name="ThemePicker" SelectedIndexChanged="OnThemeChanged">
            <Picker.Items>
                <x:String>System</x:String>
                <x:String>Light</x:String>
                <x:String>Dark</x:String>
            </Picker.Items>
        </Picker>
        <Label Text="Large Text Mode" FontAttributes="Bold"/>
        <Switch x:Name="LargeTextSwitch" Toggled="OnLargeTextToggled"/>
        <Label x:Name="PreviewLabel" Text="Preview text will scale."/>
    </VerticalStackLayout>
</ContentPage>